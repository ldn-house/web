{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ldn-house-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
